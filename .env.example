# Valores del ambiente público que se muestran en el portal (página "Ambientes" y llms.txt).
# Para desarrollo local: se leen en `npm start`/`npm run build`. Lo que no se defina aparece
# como "a definir". En la imagen Docker se pasan como env vars del contenedor (ver README).
PORTAL_SITE_URL=https://developers.ejemplo.com
PORTAL_API_URL=https://api.ejemplo.com
PORTAL_TOKEN_URL=https://auth.ejemplo.com/oauth/token
PORTAL_CONSOLE_URL=https://console.ejemplo.com
PORTAL_MCP_URL=https://mcp.ejemplo.com/mcp
# sandbox | production: con sandbox se muestran los datos de prueba.
PORTAL_MODE=sandbox
